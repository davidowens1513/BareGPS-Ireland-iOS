        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 0.6,
          10, 1,
          14, 1.8
        ]
      }
    },
    {
      "id": "contours",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 8,
      "filter": ["==", ["%", ["get", "ELEV"], 100], 0],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8b6f47",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 0.45,
          11, 0.75,
          14, 1.15,
          16, 1.5
        ]
      }
    },
    {
      "id": "contour-intermediate-lines",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 11,
      "filter": ["!=", ["%", ["get", "ELEV"], 100], 0],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
