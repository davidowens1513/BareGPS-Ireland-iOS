        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 1.1, 12, 2.2],
        "line-dasharray": [4, 2],
        "line-opacity": 0.9
      }
    },
    {
      "id": "county-boundaries",
      "type": "line",
      "source": "ireland",
      "source-layer": "boundary",
      "minzoom": 6,
      "filter": ["in", "admin_level", "5", "6"],
      "paint": {
        "line-color": "#927d96",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.55, 12, 1.1],
        "line-dasharray": [3, 2],
        "line-opacity": 0.7
      }
    },
    {
      "id": "local-boundaries",
