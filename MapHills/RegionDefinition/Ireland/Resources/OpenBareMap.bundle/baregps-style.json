{
  "version": 8,
  "name": "BareGPS Ireland",
  "sprite": "./sprites/baregps-bog27",
  "glyphs": "./fonts/{fontstack}/{range}.pbf",
  "sources": {
    "ireland": {
      "type": "vector",
      "url": "mbtiles://ireland.mbtiles"
    },
    "contours": {
      "type": "vector",
      "url": "mbtiles://contours.mbtiles"
    },
    "environment": {
      "type": "vector",
      "url": "mbtiles://environment.mbtiles"
    },
    "hillshade": {
      "type": "raster",
      "url": "mbtiles://hillshade.mbtiles",
      "tileSize": 256
    },
    "hiking": {
      "type": "vector",
      "url": "mbtiles://hiking.mbtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "irish-grid": {
      "type": "vector",
      "url": "mbtiles://grid.mbtiles",
      "attribution": "Irish Grid (EPSG:29903)"
    },
    "islands": {
      "type": "vector",
      "url": "mbtiles://islands.mbtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "townlands": {
      "type": "geojson",
      "data": "./style/townlands.geojson",
      "attribution": "Townland placenames"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#a8d7ff"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "environment",
      "source-layer": "land",
      "paint": {
        "fill-color": "#f3efe6",
        "fill-opacity": 1
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "ireland",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood", "#c8d8b0",
          "farmland", "#e4dfbd",
          "grass", "#dce7c6",
          "heath", "#d8cbb8",
          "scrub", "#cdd9b8",
          "bog", "#b9aa92",
          "wetland", "#c4d8cc",
          "beach", "#f1dfae",
          "sand", "#ead9ae",
          "#ddd8c8"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "terrain-hillshade",
      "type": "raster",
      "source": "hillshade",
      "minzoom": 6,
      "maxzoom": 17,
      "paint": {
        "raster-opacity": 0.46,
        "raster-resampling": "linear",
        "raster-fade-duration": 0
      }
    },
    {
      "id": "bare-rock",
      "type": "fill",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "bare_rock"],
      "paint": {
        "fill-color": "#d0ccc2",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.2, 14, 0.42]
      }
    },
    {
      "id": "scree-and-shingle",
      "type": "fill",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["scree", "shingle"]]],
      "paint": {
        "fill-color": ["match", ["get", "class"], "scree", "#c9c4b8", "#d8d1c3"],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0.22, 14, 0.4],
        "fill-outline-color": "#b6b0a4"
      }
    },
    {
      "id": "bare-rock-stipple",
      "type": "fill",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "bare_rock"],
      "paint": {
        "fill-pattern": "bare-rock-stipple",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.28, 13, 0.42, 16, 0.5]
      }
    },
    {
      "id": "scree-stipple",
      "type": "fill",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["scree", "shingle"]]],
      "paint": {
        "fill-pattern": "scree-stipple",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0.37, 14, 0.53, 16, 0.62]
      }
    },
    {
      "id": "cliffs-base",
      "type": "line",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "cliff"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#5f584f",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0.72, 14, 0.92],
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 14, 1.4]
      }
    },
    {
      "id": "cliffs-and-crags",
      "type": "line",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "cliff"],
      "paint": {
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0.78, 14, 0.96],
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 7, 14, 10],
        "line-pattern": "cliff-teeth"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "ireland",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a8d7ff"
      }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "ireland",
      "source-layer": "coastline",
