      "paint": {
        "fill-color": "#ddd3c5",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 14, 0.72]
      }
    },
    {
      "id": "roads-casing-major",
      "type": "line",
      "source": "ireland",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "motorway_link", "trunk", "trunk_link", "primary", "primary_link", "secondary", "secondary_link"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
