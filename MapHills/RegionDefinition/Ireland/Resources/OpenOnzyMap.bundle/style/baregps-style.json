      }
    },
    {
      "id": "service-roads-casing",
      "type": "line",
      "source": "ireland",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "service"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ad946d",
        "line-opacity": 0.95,
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.98, 12, 1.6, 14, 2.72, 16, 3.55]
      }
    },
    {
      "id": "service-roads",
      "type": "line",
      "source": "ireland",
      "source-layer": "transportation",
      "minzoom": 10,
