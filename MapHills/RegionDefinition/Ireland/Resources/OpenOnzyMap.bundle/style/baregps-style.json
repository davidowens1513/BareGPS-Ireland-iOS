      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": ["match", ["get", "class"], ["motorway", "motorway_link"], "#e59a4c", ["trunk", "trunk_link"], "#eaaa5c", ["primary", "primary_link"], "#efb978", "#f2ca96"],
