        "line-color": "#bba47f",
        "line-opacity": 0.94,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.1, 10, 2.7, 14, 5.15, 16, 6.6]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "ireland",
