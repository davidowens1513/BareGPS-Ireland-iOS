      "source-layer": "transportation_name",
      "minzoom": 10,
      "filter": ["all", ["has", "name:latin"], ["!=", ["get", "name:latin"], ""], ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "living_street", "service"], true, false]],
