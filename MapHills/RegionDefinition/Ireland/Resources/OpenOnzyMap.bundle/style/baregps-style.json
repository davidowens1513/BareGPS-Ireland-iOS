      }
    },
    {
      "id": "roads-local",
      "type": "line",
      "source": "ireland",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["tertiary", "tertiary_link", "minor", "living_street"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
