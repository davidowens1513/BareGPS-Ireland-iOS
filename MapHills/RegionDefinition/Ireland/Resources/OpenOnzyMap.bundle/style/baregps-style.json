    },
    {
      "id": "contour-labels",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": ["all", [">", ["get", "ELEV"], 0], ["==", ["%", ["get", "ELEV"], 100], 0]],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 140,
        "text-field": ["concat", ["to-string", ["get", "ELEV"]], " m"],
        "text-font": ["Open Sans Regular"],
        "text-size": 10.35,
        "text-max-angle": 25
      },
      "paint": {"text-color": "#6b573f", "text-opacity": 0.86, "text-halo-color": "#f3efe6", "text-halo-width": 0.9}
    },
    {
      "id": "road-labels",
      "type": "symbol",
