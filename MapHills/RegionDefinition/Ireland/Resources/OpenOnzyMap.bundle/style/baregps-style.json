      "minzoom": 13,
      "filter": ["all", ["has", "name:latin"], ["!=", ["get", "name:latin"], ""], ["match", ["get", "class"], ["path", "footway", "bridleway", "cycleway", "track"], true, false]],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 420,
        "text-field": ["get", "name:latin"],
        "text-font": ["Open Sans Semibold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 5.75, 16, 7.48],
