{
  "version": 8,
  "name": "BareGPS Ireland Topographic",
  "center": [-8.15412, 53.4],
  "zoom": 7,
  "sprite": "./sprites/baregps-bog24",
  "sources": {
    "ireland": {
      "type": "vector",
      "url": "mbtiles://ireland.mbtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "contours": {
      "type": "vector",
      "url": "mbtiles://contours.mbtiles",
      "attribution": "Terrain attribution to be completed before release"
    },
    "environment": {
      "type": "vector",
      "url": "mbtiles://environment.mbtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "hillshade": {
      "type": "raster",
      "url": "mbtiles://hillshade.mbtiles",
      "tileSize": 256,
      "attribution": "SRTM terrain"
    },
    "hiking": {
      "type": "vector",
      "url": "mbtiles://hiking.mbtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "irish-grid": {
      "type": "vector",
      "url": "mbtiles://grid.mbtiles",
      "attribution": "Irish Grid (EPSG:29903)"
    }
  },
  "glyphs": "./fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#a8d7ee"}
    },
    {
      "id": "land",
      "type": "fill",
      "source": "environment",
      "source-layer": "land",
      "paint": {
        "fill-color": "#f3efe6"
      }
    },
    {
      "id": "wetland",
      "type": "fill",
      "source": "environment",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": ["match", ["get", "class"], ["wetland", "swamp"], true, false],
      "paint": {
        "fill-color": ["match", ["get", "class"], "swamp", "#b8cec0", "#c9dbd2"],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0.45, 12, 0.68]
      }
    },
    {
      "id": "marsh-and-reedbed",
      "type": "fill",
      "source": "environment",
      "source-layer": "landcover",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["marsh", "reedbed"], true, false],
      "paint": {
        "fill-color": ["match", ["get", "class"], "reedbed", "#b9cfad", "#c6d8bf"],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "bog",
      "type": "fill",
      "source": "environment",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "bog"],
      "paint": {
        "fill-color": "#f2d96f",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 12, 0.74]
      }
    },
    {
      "id": "woodland",
      "type": "fill",
      "source": "environment",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "woodland"],
      "paint": {
        "fill-color": ["match", ["get", "subclass"], "forest", "#70bd56", "#8dcb72"],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0.55, 12, 0.78]
      }
    },
    {
      "id": "bare-rock",
      "type": "fill",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "bare_rock"],
      "paint": {
        "fill-color": "#d0ccc2",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.2, 14, 0.42]
      }
    },
    {
      "id": "scree-and-shingle",
      "type": "fill",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["scree", "shingle"]]],
      "paint": {
        "fill-color": ["match", ["get", "class"], "scree", "#c9c4b8", "#d8d1c3"],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0.22, 14, 0.4],
        "fill-outline-color": "#b6b0a4"
      }
    },
    {
      "id": "terrain-hillshade",
      "type": "raster",
      "source": "hillshade",
      "minzoom": 6,
      "paint": {
        "raster-opacity": ["interpolate", ["linear"], ["zoom"], 6, 1.0, 11.8, 1.0, 12.5, 0.96, 14, 0.9],
        "raster-contrast": 0.8,
        "raster-brightness-max": 0.42,
        "raster-resampling": "linear",
        "raster-fade-duration": 0
      }
    },
    {
      "id": "bog-tufts",
      "type": "fill",
      "source": "environment",
      "source-layer": "landcover",
      "minzoom": 9,
      "filter": ["==", ["get", "class"], "bog"],
      "paint": {
        "fill-pattern": ["step", ["zoom"], "bog-tuft-low", 11, "bog-tuft-mid", 13, "bog-tuft-high"],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.64, 12, 0.64, 15, 0.68]
      }
    },
    {
      "id": "cliffs-and-crags",
      "type": "line",
      "source": "environment",
      "source-layer": "terrain",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "cliff"],
      "paint": {
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0.78, 14, 0.96],
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 3.8, 14, 6],
        "line-pattern": "cliff-teeth"
      }
    },
    {
      "id": "waterway-intermittent",
      "type": "line",
      "source": "ireland",
      "source-layer": "waterway",
      "minzoom": 11,
      "filter": ["==", ["get", "intermittent"], 1],
      "paint": {
        "line-color": "#72b4cf",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0.34, 15, 0.48],
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.24, 15, 0.52],
        "line-dasharray": [2, 2.5]
      }
    },
    {
      "id": "irish-grid-1km",
      "type": "line",
      "source": "irish-grid",
      "source-layer": "grid_1km",
      "minzoom": 12,
      "paint": {
        "line-color": "#477d91",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0.38, 14, 0.5, 16, 0.54],
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.58, 14, 0.78, 16, 0.9]
      }
    },
    {
      "id": "irish-grid-10km",
      "type": "line",
      "source": "irish-grid",
      "source-layer": "grid_10km",
      "minzoom": 10,
      "paint": {
        "line-color": "#386d82",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.34, 12, 0.5, 15, 0.58],
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.72, 12, 1, 15, 1.2]
      }
    },
    {
      "id": "waterway-minor",
      "type": "line",
      "source": "ireland",
      "source-layer": "waterway",
      "minzoom": 10,
      "filter": ["all", ["!=", ["get", "intermittent"], 1], ["!", ["match", ["get", "class"], ["river", "canal"], true, false]]],
      "paint": {
        "line-color": "#69acc8",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.32, 13, 0.46, 16, 0.58],
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.22, 13, 0.4, 16, 0.65]
      }
    },
    {
      "id": "waterway-major",
      "type": "line",
      "source": "ireland",
      "source-layer": "waterway",
      "filter": ["all", ["!=", ["get", "intermittent"], 1], ["match", ["get", "class"], ["river", "canal"], true, false]],
      "paint": {
        "line-color": "#579fbe",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.58, 12, 0.7, 16, 0.76],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          6, ["match", ["get", "class"], "river", 0.5, 0.36],
          10, ["match", ["get", "class"], "river", 0.8, 0.58],
          14, ["match", ["get", "class"], "river", 1.3, 0.92],
          16, ["match", ["get", "class"], "river", 1.65, 1.15]
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "ireland",
      "source-layer": "water",
      "paint": {
        "fill-color": ["match", ["get", "class"], "ocean", "#91d2ef", "#8fc9e3"],
        "fill-opacity": 1
      }
    },
    {
      "id": "contours-intermediate",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 11,
      "filter": ["all", [">", ["get", "ELEV"], 0], ["!=", ["%", ["get", "ELEV"], 100], 0]],
      "paint": {
        "line-color": "#987b59",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0.32, 12, 0.42, 14, 0.72, 16, 0.82],
